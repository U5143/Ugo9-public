<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-independent part of the Unity package, run against the real C core.
       Needs the shared core (CMake option UGO_SHARED); see tests/unity_core/Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../engines/unity/com.ugo9.runtime/Runtime/Core/*.cs" />
  </ItemGroup>
</Project>
